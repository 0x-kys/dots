{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "modules-left": [
    "custom/nixos",
    "cpu",
    "memory",
    "hyprland/workspaces",
    "cava",
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "network",
    "clock",
    "tray",
    "custom/dnd",
    "group/expand",
  ],
  "custom/nixos": {
    "format": "󰄛",
    "tooltip": false,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "show-special": false,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
    },
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "network": {
    "format-wifi": "󰖩  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪  Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 15,
  },
  "cpu": {
    "format": "󰍛  {usage}%",
    "tooltip": true,
    "interval": 1,
  },
  "memory": {
    "format": "󰘚  {}%",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB",
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15,
    },
    "format": "󰁹  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰂄  {capacity}%",
    "format-icons": ["󰂎 ", "󰁺 ", "󰁽 ", "󰁽 ", "󰁹 "],
  },
  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "󰸘  {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#e0def4'><b>{}</b></span>",
        "weeks": "<span color='#9ccfd8'><b>{}</b></span>",
        "weekdays": "<span color='#f6c177'><b>{}</b></span>",
        "today": "<span color='#eb6f92'><b>{}</b></span>",
      },
    },
  },
  "cava": {
    "framerate": 60,
    "autosens": 0.8,
    "sensitivity": 2,
    "bars": 16,
    "lower_cutoff_freq": 20,
    "higher_cutoff_freq": 20000,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": true,
    "waves": true,
    "noise_reduction": 0.5,
    "input_delay": 2,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
      "on-click-right": "mode",
    },
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6,
  },
  "custom/dnd": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "do-not-disturb": "󰍶",
    },
    "return-type": "json",
    "exec": "echo '{\"alt\":\"'$(makoctl mode)'\"}'",
    "interval": 2,
    "on-click": "makoctl mode -s $(makoctl mode | grep -q 'do-not-disturb' && echo 'default' || echo 'do-not-disturb')",
    "tooltip": true,
    "tooltip-format": "DND: {alt}",
  },
  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-to-left": true,
      "click-to-reveal": true,
    },
    "modules": [
      "custom/expand",
      "custom/swaylock",
      "custom/suspend",
      "custom/hibernate",
      "custom/reboot",
      "custom/exit_hyprland",
      "custom/endpoint",
    ],
  },
  "custom/expand": {
    "format": "󰅂",
    "tooltip": false,
  },
  "custom/endpoint": {
    "format": "󰿅",
    "tooltip": false,
  },
  "custom/swaylock": {
    "format": "󰍁",
    "on-click": "swaylock --screenshots --clock --datestr '%a %e.%m.%Y' --timestr '%H:%M' --effect-blur 10x2 --indicator",
    "tooltip": false,
  },
  "custom/suspend": {
    "format": "󰤄",
    "on-click": "systemctl suspend",
    "tooltip": false,
  },
  "custom/reboot": {
    "format": "󰜉",
    "on-click": "systemctl reboot",
    "tooltip": false,
  },
  "custom/exit_hyprland": {
    "format": "󰍃",
    "on-click": "hyprctl dispatch exit",
    "tooltip": false,
  },
}
