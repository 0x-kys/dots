#!/bin/sh

# Set wallpaper
riverctl spawn "waypaper --restore"

riverctl spawn "dbus-update-activation-environment SEATD_SOCK DISPLAY WAYLAND _DISPLAY XDG_CURRENT_DESKTOP=river"

# reload
riverctl map normal Super+Shift R spawn $HOME/.config/river/init

# Screenshot
riverctl map normal None Print spawn 'IMG=~/Pictures/screenshots/$(date | sed "s/\s/-/g" | sed "s/--/-/g").png&&grim -g "$(slurp)" $IMG && cat $IMG | wl-copy && notify-send "Screenshot has been saved and copied to your clipboard" -a "grim" -u normal -t 2000'

# Start terminal
riverctl map normal Super Return spawn ghostty

# Start launcher
riverctl map normal Super R spawn anyrun

# Close focused view
riverctl map normal Super Q close

# Exit river
riverctl map normal Super+Shift E exit

# Focus next/previous view with Super + Down/Up
riverctl map normal Super Down focus-view next
riverctl map normal Super Up focus-view previous

# Swap focused view with next/previous with Super + Shift + Down/Up
riverctl map normal Super+Shift Down swap next
riverctl map normal Super+Shift Up swap previous

# Focus next/previous output with Super + Right/Left
riverctl map normal Super Right focus-output next
riverctl map normal Super Left focus-output previous

# Send focused view to next/previous output with Super + Shift + Right/Left
riverctl map normal Super+Shift Right send-to-output next
riverctl map normal Super+Shift Left send-to-output previous

# Bump focused view to top of layout stack
riverctl map normal Super Z zoom

# Adjust main ratio with Super + Ctrl + Left/Right
riverctl map normal Super+Ctrl Left send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal Super+Ctrl Right send-layout-cmd rivertile "main-ratio +0.05"

# Adjust main count with Super + Ctrl + Up/Down
riverctl map normal Super+Ctrl Up send-layout-cmd rivertile "main-count +1"
riverctl map normal Super+Ctrl Down send-layout-cmd rivertile "main-count -1"

# Move floating views with Super + Alt + Arrow
riverctl map normal Super+Alt Left move left 100
riverctl map normal Super+Alt Down move down 100
riverctl map normal Super+Alt Up move up 100
riverctl map normal Super+Alt Right move right 100

# Snap views to screen edges with Super + Ctrl + Alt + Arrow
riverctl map normal Super+Ctrl+Alt Left snap left
riverctl map normal Super+Ctrl+Alt Down snap down
riverctl map normal Super+Ctrl+Alt Up snap up
riverctl map normal Super+Ctrl+Alt Right snap right

# Resize floating views with Super + Shift + Arrow
riverctl map normal Super+Shift Left resize horizontal -100
riverctl map normal Super+Shift Down resize vertical 100
riverctl map normal Super+Shift Up resize vertical -100
riverctl map normal Super+Shift Right resize horizontal 100

# Move views with Super + Left Mouse Button
riverctl map-pointer normal Super BTN_LEFT move-view

# Resize views with Super + Right Mouse Button
riverctl map-pointer normal Super BTN_RIGHT resize-view

# Tag navigation (1–10)
for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))
    # Super+[1-9] to focus tag [0-8]
    riverctl map normal Super $i set-focused-tags $tags
    # Super+Shift+[1-9] to tag focused view with tag [0-8]
    riverctl map normal Super+Shift $i set-view-tags $tags
    # Super+Alt+[1-9] to toggle focus of tag [0-8]
    riverctl map normal Super+Alt $i toggle-focused-tags $tags
done
# Super+0 for tag 10
riverctl map normal Super 0 set-focused-tags $((1 << 9))
riverctl map normal Super+Shift 0 set-view-tags $((1 << 9))
riverctl map normal Super+Alt 0 toggle-focused-tags $((1 << 9))

# Super+Space to toggle float
riverctl map normal Super Space toggle-float

# Super+F to toggle fullscreen
riverctl map normal Super F toggle-fullscreen

# Change layout orientation with Super + Shift + Arrow
riverctl map normal Super+Shift Up send-layout-cmd rivertile "main-location top"
riverctl map normal Super+Shift Right send-layout-cmd rivertile "main-location right"
riverctl map normal Super+Shift Down send-layout-cmd rivertile "main-location bottom"
riverctl map normal Super+Shift Left send-layout-cmd rivertile "main-location left"

# Passthrough mode for testing nested compositors
riverctl declare-mode passthrough
riverctl map normal Super F11 enter-mode passthrough
riverctl map passthrough Super F11 enter-mode normal

# Media keys for normal and locked modes
for mode in normal locked
do
    riverctl map $mode None XF86Eject spawn 'eject -T'
    riverctl map $mode None XF86AudioRaiseVolume spawn 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+'
    riverctl map $mode None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
    riverctl map $mode None XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
    riverctl map $mode None XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
    riverctl map $mode None XF86AudioMedia spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioPlay spawn 'playerctl play-pause'
    riverctl map $mode None XF86AudioPrev spawn 'playerctl previous'
    riverctl map $mode None XF86AudioNext spawn 'playerctl next'
    riverctl map $mode None XF86MonBrightnessUp spawn 'brightnessctl s 10%+'
    riverctl map $mode None XF86MonBrightnessDown spawn 'brightnessctl s 10%-'
done

# auto starting apps
bash $HOME/.config/river/autostart.sh

# Set background and border colors
riverctl background-color 0x11111b
riverctl border-color-focused 0x89B4FA
riverctl border-color-unfocused 0x313244

# Set keyboard repeat rate
riverctl set-repeat 50 300

# Rules for floating windows and client-side decorations
riverctl float-filter-add "popup"
riverctl float-filter-add "float"
riverctl rule-add -app-id "bar" csd

# Set default layout to rivertile
riverctl spawn "rivertile -a 0.5"
rivertile -view-padding 2 -outer-padding 4 &
exec rivertile

riverctl focus-follows-cursor normal
