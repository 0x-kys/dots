font=Noto Sans 11
width=300
height=100
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=left
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right
sort=-time

background-color=#191724
text-color=#e0def4
border-color=#26233a
progress-color=over #f6c177

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#26233a
default-timeout=2000
progress-color=over #f6c177

[urgency=normal]
border-color=#26233a
default-timeout=5000
progress-color=over #31748f

[urgency=high]
border-color=#eb6f92
text-color=#eb6f92
default-timeout=0
progress-color=over #eb6f92

[category=mpd]
border-color=#ebbcba
default-timeout=2000
group-by=category

[mode=do-not-disturb]
invisible=1
