# Ghostty config - minimal, keyboard-friendly, Gruvbox-like
# Adjust path/name if your Ghostty config is elsewhere.

# Visuals & theme
theme = "Gruvbox Dark"
window-theme = "system"         
maximize = true

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 10

# Window padding: small but visible
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# Window chrome & decorations
window-decoration = "server"  
window-titlebar-background = "000000"
window-titlebar-foreground = "ffffff"

# Background
background = "000000"
background-opacity = 0.74      
background-blur = false

# Splits / opacity
unfocused-split-opacity = 1   

# Cursor + selection
cursor-style = "block"
cursor-style-blink = true
cursor-invert-fg-bg = true
selection-invert-fg-bg = true

# Shell integration
shell-integration = "fish"
working-directory = "inherit"

# Animations (dev tip)
# custom-shader-animation = "always"  

